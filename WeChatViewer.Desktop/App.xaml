<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WeChatViewer.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WeChatViewer.Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- WeChat palette, adapted to Fluent theme (light + dark) -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WxSidebarBrush" Color="#E9EDEDE9"/>
                    <SolidColorBrush x:Key="WxMainBrush" Color="#E9F7F7F5"/>
                    <SolidColorBrush x:Key="WxHeaderBrush" Color="#D9F7F7F7"/>
                    <SolidColorBrush x:Key="WxBubbleInBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="WxBubbleOutBrush" Color="#95EC69"/>
                    <SolidColorBrush x:Key="WxTextBrush" Color="#191919"/>
                    <SolidColorBrush x:Key="WxNameBrush" Color="#8A8A8A"/>
                    <SolidColorBrush x:Key="WxSummaryBrush" Color="#8A8A8A"/>
                    <SolidColorBrush x:Key="WxMutedBrush" Color="#999999"/>
                    <SolidColorBrush x:Key="WxTimeBrush" Color="#B5B5B5"/>
                    <SolidColorBrush x:Key="WxLinkBrush" Color="#576B95"/>
                    <SolidColorBrush x:Key="WxLineBrush" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="WxQuoteInBrush" Color="#E3E3E3"/>
                    <SolidColorBrush x:Key="WxQuoteOutBrush" Color="#48382828"/>
                    <SolidColorBrush x:Key="WxQuoteTextBrush" Color="#555555"/>
                    <SolidColorBrush x:Key="WxDaySepBrush" Color="#C9E4E4E4"/>
                    <SolidColorBrush x:Key="WxHoverBrush" Color="#66D9D9D9"/>
                    <SolidColorBrush x:Key="WxActiveBrush" Color="#80CFCFCF"/>
                    <SolidColorBrush x:Key="WxAccentBrush" Color="#07C160"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WxSidebarBrush" Color="#D9252525"/>
                    <SolidColorBrush x:Key="WxMainBrush" Color="#D9202020"/>
                    <SolidColorBrush x:Key="WxHeaderBrush" Color="#B3282828"/>
                    <SolidColorBrush x:Key="WxBubbleInBrush" Color="#333333"/>
                    <SolidColorBrush x:Key="WxBubbleOutBrush" Color="#95EC69"/>
                    <SolidColorBrush x:Key="WxTextBrush" Color="#F1F1F1"/>
                    <SolidColorBrush x:Key="WxNameBrush" Color="#9A9A9A"/>
                    <SolidColorBrush x:Key="WxSummaryBrush" Color="#9A9A9A"/>
                    <SolidColorBrush x:Key="WxMutedBrush" Color="#8F8F8F"/>
                    <SolidColorBrush x:Key="WxTimeBrush" Color="#7A7A7A"/>
                    <SolidColorBrush x:Key="WxLinkBrush" Color="#7DA6EA"/>
                    <SolidColorBrush x:Key="WxLineBrush" Color="#3A3A3A"/>
                    <SolidColorBrush x:Key="WxQuoteInBrush" Color="#3F3F3F"/>
                    <SolidColorBrush x:Key="WxQuoteOutBrush" Color="#48242424"/>
                    <SolidColorBrush x:Key="WxQuoteTextBrush" Color="#C9C9C9"/>
                    <SolidColorBrush x:Key="WxDaySepBrush" Color="#663A3A3A"/>
                    <SolidColorBrush x:Key="WxHoverBrush" Color="#33333333"/>
                    <SolidColorBrush x:Key="WxActiveBrush" Color="#4D3F3F3F"/>
                    <SolidColorBrush x:Key="WxAccentBrush" Color="#07C160"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
