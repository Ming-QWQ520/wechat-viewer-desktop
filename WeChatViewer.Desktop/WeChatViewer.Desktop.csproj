<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WeChatViewer.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12</LangVersion>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Custom Main in Program.cs: full startup logging + fatal error MessageBox -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Drop ~15 locale satellite folders from the publish output -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <!-- Unpackaged, self-contained: no MSIX install, no WindowsAppRuntime dependency -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <Version>2.1.0</Version>
    <Authors>Ming-QWQ520</Authors>
    <Product>WeChatViewer Desktop</Product>
    <Description>微信聊天记录查看器（WinUI 3 桌面版）：本机只读查看与导出微信 4.x 聊天记录</Description>
    <AssemblyTitle>微信聊天记录查看器</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Native helper tools are copied into the publish output by CI -->
    <None Include="..\tools\wechat-keys.exe" Condition="Exists('..\tools\wechat-keys.exe')">
      <Link>tools\wechat-keys.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="..\tools\imgcheck.exe" Condition="Exists('..\tools\imgcheck.exe')">
      <Link>tools\imgcheck.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="..\tools\silkdec.exe" Condition="Exists('..\tools\silkdec.exe')">
      <Link>tools\silkdec.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\PublishProfiles\win-x64.pubxml" />
  </ItemGroup>

</Project>
